</Layout>

<script is:inline>
    // --- LÓGICA DE PESQUISA ADAPTADA PARA SUB-ARTISTAS ---
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('buscaDiscografia');
        const secoesArtistas = document.querySelectorAll('.artista-section');
        const noResults = document.getElementById('noResults');

        if (searchInput) {
            searchInput.addEventListener('input', () => {
                const termoBusca = searchInput.value.toLowerCase().trim();
                let encontrouQualquer = false;

                secoesArtistas.forEach(secao => {
                    const nomeArtista = secao.getAttribute('data-artista');
                    const albuns = secao.querySelectorAll('.album-item');
                    let encontrouAlbumNaSecao = false;

                    const artistaCombina = nomeArtista.includes(termoBusca);

                    albuns.forEach(album => {
                        const tituloAlbum = album.getAttribute('data-titulo');
                        const subArtistaNome = album.getAttribute('data-subartista') || '';

                        if (artistaCombina || tituloAlbum.includes(termoBusca) || subArtistaNome.includes(termoBusca)) {
                            album.style.display = 'flex';
                            encontrouAlbumNaSecao = true;
                        } else {
                            album.style.display = 'none';
                        }
                    });

                    // Verifica e oculta/mostra o cabeçalho dos sub-artistas (Música Tradicionalista)
                    const subGrupos = secao.querySelectorAll('.sub-artista-group');
                    subGrupos.forEach(grupo => {
                        const albunsVisiveis = Array.from(grupo.querySelectorAll('.album-item')).filter(a => a.style.display !== 'none');
                        if (albunsVisiveis.length > 0 || artistaCombina) {
                            grupo.style.display = 'block';
                        } else {
                            grupo.style.display = 'none';
                        }
                    });

                    if (artistaCombina || encontrouAlbumNaSecao) {
                        secao.style.display = 'block';
                        encontrouQualquer = true;
                    } else {
                        secao.style.display = 'none';
                    }
                });

                if (encontrouQualquer) {
                    if (noResults) noResults.classList.add('hidden');
                } else {
                    if (noResults) noResults.classList.remove('hidden');
                }

                atualizarSetasCarrossel();
            });

            const urlParams = new URLSearchParams(window.location.search);
            const buscaDaUrl = urlParams.get('busca');
            
            if (buscaDaUrl) {
                searchInput.value = buscaDaUrl; 
                searchInput.dispatchEvent(new Event('input'));
            }
        }
    });

    window.rolarCarrossel = (id, direcao) => {
        const container = document.getElementById(id);
        if (container) {
            const quantidadeRolagem = 300 * direcao;
            container.scrollBy({ left: quantidadeRolagem, behavior: 'smooth' });
        }
    };

    function atualizarSetasCarrossel() {
        const wrappers = document.querySelectorAll('.carrossel-wrapper');
        
        wrappers.forEach(wrapper => {
            const container = wrapper.querySelector('.carrossel-container');
            const btns = wrapper.querySelectorAll('.carrossel-btn');
            
            if (container && btns.length) {
                if (container.scrollWidth > Math.ceil(container.clientWidth)) {
                    btns.forEach(btn => btn.style.display = ''); 
                } else {
                    btns.forEach(btn => btn.style.display = 'none'); 
                }
            }
        });
    }

    document.addEventListener('DOMContentLoaded', atualizarSetasCarrossel);
    window.addEventListener('resize', atualizarSetasCarrossel);
    setTimeout(atualizarSetasCarrossel, 150);

    const overlay = document.getElementById('modal-overlay');
    const content = document.getElementById('modal-content');
    const mTitulo = document.getElementById('modal-titulo');
    const mAutor = document.getElementById('modal-autor');
    const mAno = document.getElementById('modal-ano');
    const mCapa = document.getElementById('modal-capa');
    const mFaixas = document.getElementById('modal-faixas');

    window.abrirAlbum = (id, nomeAutor) => {
        const dataDiv = document.getElementById(`data-${id}`);
        if (!dataDiv) return;

        const titulo = dataDiv.querySelector('.data-titulo').innerText;
        const ano = dataDiv.querySelector('.data-ano').innerText;
        const capa = dataDiv.querySelector('.data-capa').innerText;
        const faixas = JSON.parse(dataDiv.querySelector('.data-faixas').innerText);

        mTitulo.innerText = titulo;
        mAutor.innerHTML = `<svg class="w-4 h-4 inline-block mr-1 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"></path></svg> <span class="truncate">${nomeAutor}</span>`;
        mAno.innerText = ano;
        mCapa.src = capa;

        mFaixas.innerHTML = ''; 
        faixas.forEach((faixa, index) => {
            const li = document.createElement('li');
            li.className = "flex items-start gap-3 text-sm group/item cursor-default p-2 hover:bg-stone-50 rounded-md transition-colors";
            li.innerHTML = `
                <div class="flex items-center justify-center w-6 h-6 rounded bg-stone-100 text-rose-600 font-mono text-xs font-bold shrink-0 shadow-inner mt-0.5">
                    ${(index + 1).toString().padStart(2, '0')}
                </div>
                <span class="group-hover/item:text-rose-700 font-medium transition-colors">${faixa}</span>
            `;
            mFaixas.appendChild(li);
        });

        overlay.classList.remove('hidden');
        setTimeout(() => {
            overlay.classList.remove('opacity-0');
            content.classList.remove('scale-95');
            content.classList.add('scale-100');
        }, 10);
        document.body.style.overflow = 'hidden';
    }

    window.fecharModal = () => {
        overlay.classList.add('opacity-0');
        content.classList.remove('scale-100');
        content.classList.add('scale-95');
        setTimeout(() => {
            overlay.classList.add('hidden');
            document.body.style.overflow = 'auto';
        }, 300);
    }

    overlay.addEventListener('click', (e) => { if (e.target === overlay) fecharModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !overlay.classList.contains('hidden')) fecharModal(); });
</script>

<style>
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>
