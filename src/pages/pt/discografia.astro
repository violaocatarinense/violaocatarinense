import Layout from '../../layouts/Layout.astro';

// --- BANCO DE DADOS DA DISCOGRAFIA ---
import { discografia } from '../../data/discografia.js';

const lang = 'pt';
// --- NOVA LÓGICA DE ORDENAÇÃO ---
const secoesEspeciaisNomes = ["Violonistas diversos", "Duos", "Quartetos", "Formações Diversas", "Música Tradicionalista"];

// 1. Separa o que é artista comum do que é seção especial
const artistasComuns = discografia.filter(a => !secoesEspeciaisNomes.includes(a.nome));
const secoesEspeciais = discografia.filter(a => secoesEspeciaisNomes.includes(a.nome));

// 2. Ordena os artistas comuns por ordem alfabética
artistasComuns.sort((a, b) => a.nome.localeCompare(b.nome));

// 3. Ordena as seções especiais conforme a ordem do array 'secoesEspeciaisNomes'
secoesEspeciais.sort((a, b) => 
  secoesEspeciaisNomes.indexOf(a.nome) - secoesEspeciaisNomes.indexOf(b.nome)
);

// 4. Junta tudo: primeiro os alfabéticos, depois os especiais
const discografiaFinal = [...artistasComuns, ...secoesEspeciais];

// 5. Ordena os álbuns de cada item e sub-item por ano
discografiaFinal.forEach(artista => {
  if(artista.albuns) {
    artista.albuns.sort((a, b) => parseInt(a.ano) - parseInt(b.ano));
  }
  if(artista.subArtistas) {
    artista.subArtistas.forEach(sub => {
      if(sub.albuns) {
        sub.albuns.sort((a, b) => parseInt(a.ano) - parseInt(b.ano));
      }
    });
  }
});
