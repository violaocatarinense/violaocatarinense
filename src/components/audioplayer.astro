---
// src/components/AudioPlayer.astro

// 1. Substitua pelas URLs públicas geradas no seu bucket do Supabase
const playlist = [
  {
    title: "Romanceiro",
    artist: "Andrei Uller",
    src: "https://rylphwqipmqmoqjqawem.supabase.co/storage/v1/object/public/audios/Romanceiro.mp3",
  },
  // Adicione outras faixas aqui conforme fizer upload no Supabase
];
---

<aside
  transition:persist="global-supabase-player"
  class="fixed bottom-4 right-4 z-50 flex items-center gap-1 bg-[#6e1423] text-stone-100 px-4 py-3 rounded-2xl shadow-2xl backdrop-blur-md border border-rose-800/50 shadow-black/30"
>
  <!-- Anterior -->
  <button
    id="btn-prev"
    type="button"
    class="p-2 text-rose-300/60 hover:text-rose-100 transition-colors cursor-pointer"
    aria-label="Música anterior"
  >
    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
      <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
    </svg>
  </button>

  <!-- Play / Pause -->
  <button
    id="btn-play-pause"
    type="button"
    class="w-10 h-10 flex items-center justify-center rounded-full bg-amber-600/90 hover:bg-amber-500 text-white transition-transform active:scale-95 cursor-pointer shrink-0 shadow-md shadow-amber-950/30"
    aria-label="Tocar ou pausar"
  >
    <svg id="icon-play" class="w-5 h-5 fill-current ml-0.5" viewBox="0 0 24 24">
      <path d="M8 5v14l11-7z"/>
    </svg>
    <svg id="icon-pause" class="w-5 h-5 fill-current hidden" viewBox="0 0 24 24">
      <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
    </svg>
  </button>

  <!-- Próxima -->
  <button
    id="btn-next"
    type="button"
    class="p-2 text-rose-300/60 hover:text-rose-100 transition-colors cursor-pointer"
    aria-label="Próxima música"
  >
    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
      <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
    </svg>
  </button>

  <!-- Informações da Faixa -->
  <div class="text-xs leading-tight min-w-[130px] max-w-[200px] truncate pl-1">
    <p id="player-title" class="font-bold text-rose-50 truncate">{playlist[0]?.title || "Sem título"}</p>
    <p id="player-artist" class="text-rose-300/70 truncate">{playlist[0]?.artist || ""}</p>
  </div>

  <!-- Controle de Volume Vertical com Hover -->
  <div class="flex items-center pl-3 ml-1 border-l border-rose-800/50">
    <div class="relative group flex items-center justify-center">
      <button
        id="btn-mute"
        type="button"
        class="text-rose-300/60 hover:text-rose-100 transition-colors cursor-pointer py-2 px-1"
        aria-label="Mutar ou desmutar volume"
      >
        <!-- Ícone Som Ligado -->
        <svg id="icon-vol-up" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
        </svg>
        <!-- Ícone Mudo -->
        <svg id="icon-vol-mute" class="w-5 h-5 fill-current hidden" viewBox="0 0 24 24">
          <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
        </svg>
      </button>
      
      <!-- Wrapper invisível que serve como "ponte" para o mouse não perder o foco -->
      <div class="absolute bottom-full left-1/2 -translate-x-1/2 pb-3 opacity-0 group-hover:opacity-100 transition-all pointer-events-none group-hover:pointer-events-auto origin-bottom">
        
        <!-- Popover visual da barra de volume -->
        <div class="relative p-2 bg-[#6e1423] rounded-xl shadow-2xl border border-rose-800/50 flex flex-col items-center">
          
          <!-- Container de altura fixa para abrigar o input rotacionado -->
          <div class="h-24 w-6 flex items-center justify-center">
            <input
              id="volume-slider"
              type="range"
              min="0"
              max="1"
              step="0.01"
              value="1"
              class="w-24 h-1.5 bg-rose-950 rounded-lg appearance-none cursor-pointer accent-amber-500 -rotate-90 origin-center"
              aria-label="Controle de volume vertical"
            />
          </div>

          <!-- Triângulo apontando para baixo (estética do balãozinho) -->
          <div class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-3 h-3 bg-[#6e1423] border-b border-r border-rose-800/50 rotate-45"></div>
        </div>

      </div>
    </div>
  </div>

  <audio id="global-audio-element" preload="metadata"></audio>
</aside>

<script define:vars={{ playlist }}>
  let currentIndex = 0;
  let autoplayHandled = false;
  let lastVolume = 1;

  function initPlayer() {
    const audio = document.getElementById('global-audio-element');
    const btnPlay = document.getElementById('btn-play-pause');
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    const iconPlay = document.getElementById('icon-play');
    const iconPause = document.getElementById('icon-pause');
    const trackTitle = document.getElementById('player-title');
    const trackArtist = document.getElementById('player-artist');
    
    // Elementos de Volume
    const btnMute = document.getElementById('btn-mute');
    const volumeSlider = document.getElementById('volume-slider');
    const iconVolUp = document.getElementById('icon-vol-up');
    const iconVolMute = document.getElementById('icon-vol-mute');

    if (!audio || !btnPlay || !playlist.length) return;

    function updateUI() {
      if (trackTitle) trackTitle.textContent = playlist[currentIndex].title;
      if (trackArtist) trackArtist.textContent = playlist[currentIndex].artist;

      if (audio.paused) {
        iconPlay?.classList.remove('hidden');
        iconPause?.classList.add('hidden');
      } else {
        iconPlay?.classList.add('hidden');
        iconPause?.classList.remove('hidden');
      }
    }

    function updateVolumeUI() {
      const isMuted = audio.muted || audio.volume === 0;
      
      if (isMuted) {
        iconVolUp?.classList.add('hidden');
        iconVolMute?.classList.remove('hidden');
      } else {
        iconVolUp?.classList.remove('hidden');
        iconVolMute?.classList.add('hidden');
      }
      
      if (volumeSlider) {
        volumeSlider.value = isMuted ? 0 : audio.volume;
      }
    }

    function loadTrack(index, autoPlay = true) {
      currentIndex = index;
      audio.src = playlist[currentIndex].src;
      updateUI();
      if (autoPlay) {
        audio.play().catch(() => {});
      }
    }

    if (!audio.src) {
      audio.src = playlist[0].src;
    }
    
    if (volumeSlider) {
      audio.volume = volumeSlider.value;
      lastVolume = audio.volume;
    }
    updateUI();
    updateVolumeUI();

    if (!autoplayHandled && audio.paused) {
      autoplayHandled = true;

      audio.play().catch(() => {
        const triggerAutoplayOnInteraction = () => {
          if (audio.paused) {
            audio.play().then(updateUI).catch(() => {});
          }
          window.removeEventListener('click', triggerAutoplayOnInteraction);
          window.removeEventListener('keydown', triggerAutoplayOnInteraction);
          window.removeEventListener('touchstart', triggerAutoplayOnInteraction);
        };

        window.addEventListener('click', triggerAutoplayOnInteraction, { once: true });
        window.addEventListener('keydown', triggerAutoplayOnInteraction, { once: true });
        window.addEventListener('touchstart', triggerAutoplayOnInteraction, { once: true });
      });
    }

    btnPlay.onclick = () => {
      if (audio.paused) {
        audio.play().catch(() => {});
      } else {
        audio.pause();
      }
      updateUI();
    };

    btnNext.onclick = () => {
      const nextIndex = (currentIndex + 1) % playlist.length;
      loadTrack(nextIndex, true);
    };

    btnPrev.onclick = () => {
      const prevIndex = (currentIndex - 1 + playlist.length) % playlist.length;
      loadTrack(prevIndex, true);
    };

    if (volumeSlider) {
      volumeSlider.addEventListener('input', (e) => {
        const val = parseFloat(e.target.value);
        audio.muted = false;
        audio.volume = val;
        if (val > 0) lastVolume = val;
        updateVolumeUI();
      });
    }

    if (btnMute) {
      btnMute.onclick = () => {
        if (audio.muted || audio.volume === 0) {
          audio.muted = false;
          audio.volume = lastVolume > 0 ? lastVolume : 0.5;
        } else {
          audio.muted = true;
        }
        updateVolumeUI();
      };
    }

    audio.onended = () => {
      const nextIndex = (currentIndex + 1) % playlist.length;
      loadTrack(nextIndex, true);
    };

    audio.onplay = updateUI;
    audio.onpause = updateUI;
  }

  initPlayer();
  document.addEventListener('astro:page-load', initPlayer);
</script>
